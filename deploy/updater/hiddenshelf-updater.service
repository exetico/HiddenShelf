# Runs one queued update or rollback. Started by hiddenshelf-updater.path.
# @USER@ and @DIR@ are filled in by install.sh.
[Unit]
Description=Hidden Shelf updater (runs a queued update or rollback)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/deploy/updater/hiddenshelf-updater.sh run
NoNewPrivileges=true
PrivateTmp=true
UMask=0022
TimeoutStartSec=45min
