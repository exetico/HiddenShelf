# Fetches main and lists the commits an update would bring in
[Unit]
Description=Hidden Shelf updater: check for new versions
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@DIR@
ExecStart=@DIR@/deploy/updater/hiddenshelf-updater.sh check
NoNewPrivileges=true
PrivateTmp=true
UMask=0022
