# Hidden Shelf — Environment Variables
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for local development.

# ── Server ─────────────────────────────────────────────────────────
PORT=3000

# ── Database ───────────────────────────────────────────────────────
DB_PATH=./db/database.sqlite

# ── Site ───────────────────────────────────────────────────────────
SITE_URL=http://localhost:3000          # Public URL (no trailing slash)
BASE_PATH=                              # Subpath if behind a proxy, e.g. /shelf
SITE_NAME=Hidden Shelf

# ── Email / SMTP ───────────────────────────────────────────────────
SMTP_HOST=mail.smtpbucket.com           # Default: smtpbucket.com (no auth needed for dev)
SMTP_PORT=8025
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=                        # tls | ssl | (empty)
FROM_EMAIL=noreply@example.com
FROM_NAME=Hidden Shelf

# ── Magic Link ─────────────────────────────────────────────────────
MAGIC_LINK_EXPIRY=900                   # Seconds until token expires (default: 15 min)

# ── Session ────────────────────────────────────────────────────────
SESSION_NAME=hiddenshelf_session
SESSION_LIFETIME=2592000                # Seconds (default: 30 days)
SESSION_SECRET=change-me-in-production-please

# ── Pagination ─────────────────────────────────────────────────────
LINKS_PER_PAGE=20

# ── Feature Flags ──────────────────────────────────────────────────
DEBUG_MODE=false                        # Set to true to log magic links to console instead of emailing
SIGNUP_ENABLED=true                     # Set to false to disable new user registration

# ── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── App Version ────────────────────────────────────────────────────
APP_VERSION=2.0.0
