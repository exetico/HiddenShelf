# Hidden Shelf — Environment Variables
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for local development.
#
# Keep comments on their own lines. Some Docker Compose versions read
# "NAME=   # comment" as the value "# comment".

# ── Server ─────────────────────────────────────────────────────────
# Port the app listens on when run with Node directly. Docker always uses
# 3000 inside the container; set HOST_PORT instead.
PORT=3000
# Docker only: where the container is published on the host. Use
# 127.0.0.1:3000 when a reverse proxy on the same machine is in front.
HOST_PORT=3000

# ── Database ───────────────────────────────────────────────────────
# Node only; Docker always uses db/ next to docker-compose.yml.
DB_PATH=./db/database.sqlite

# ── Site ───────────────────────────────────────────────────────────
# Public URL, no trailing slash
SITE_URL=http://localhost:3000
# Subpath if served under one, e.g. /shelf. Leave empty for a whole domain.
BASE_PATH=
SITE_NAME=Hidden Shelf

# ── Email / SMTP ───────────────────────────────────────────────────
# The default, smtpbucket.com, is a public test inbox: development only.
SMTP_HOST=mail.smtpbucket.com
SMTP_PORT=8025
SMTP_USER=
SMTP_PASS=
# tls (usually port 587), ssl (port 465) or empty
SMTP_ENCRYPTION=
# Use an address on your own domain, with SPF, DKIM and DMARC set up for
# it, or login emails may land in spam (README: "Email delivery")
FROM_EMAIL=noreply@example.com
FROM_NAME=Hidden Shelf
# Optional DKIM signing, only if your SMTP server doesn't sign for you.
# Key as PEM with \n for line breaks, or a file inside the container
DKIM_DOMAIN=
DKIM_SELECTOR=
DKIM_PRIVATE_KEY=
DKIM_PRIVATE_KEY_FILE=

# ── Magic Link ─────────────────────────────────────────────────────
# Seconds until a login link expires (15 minutes)
MAGIC_LINK_EXPIRY=900

# ── Session ────────────────────────────────────────────────────────
SESSION_NAME=hiddenshelf_session
# Seconds (30 days)
SESSION_LIFETIME=2592000

# ── Reverse proxy ──────────────────────────────────────────────────
# Whether to believe X-Forwarded-For / CF-Connecting-IP for the client IP.
# Empty: only when the request comes from a private/loopback address (a proxy
# on the same host or Docker network). Set true behind a remote proxy or CDN.
TRUST_PROXY=

# ── Pagination ─────────────────────────────────────────────────────
LINKS_PER_PAGE=20

# ── Feature Flags ──────────────────────────────────────────────────
# true logs magic links to the console instead of emailing them (dev only)
DEBUG_MODE=false
# false closes registration for new users
SIGNUP_ENABLED=true
# Set to false to turn off magic link login: no email is sent and the SMTP
# settings are unused. Google sign-in must be configured then.
EMAIL_LOGIN_ENABLED=true

# ── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Leave empty to use {SITE_URL}/api/auth/google/callback, the URL to register
# in Google Cloud Console. Only set it if Google must call back somewhere else.
GOOGLE_REDIRECT_URI=

# ── App Version ────────────────────────────────────────────────────
APP_VERSION=2.0.0
